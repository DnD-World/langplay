{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Langplay window may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "opener:allow-open-url",
    "process:allow-restart",
    "process:allow-exit",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "https://*/*" },
        { "url": "http://localhost:*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
